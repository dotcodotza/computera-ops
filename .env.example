# ---------------------------------------------------------------
# Computera Ops — fleet configuration
# Copy to .env (gitignored) on each machine and edit.
# Same FLEET_TOKEN on every node; everything else is per-machine.
# ---------------------------------------------------------------

# master = the workspace node and the only writer to the shared database.
# worker = any other machine; it reads the calendar/roster from the master.
NODE_ROLE=master

# Workers only: base URL of the master node.
#MASTER_URL=http://192.168.1.10:3001

# Stable identity for this node in the fleet roster.
#WORKER_ID=desk-2
#WORKER_NAME=Desk 2
# Max tasks this node should run at once (advisory, used for load balancing).
#MAX_CONCURRENCY=1

# Public tunnel URL for this node. Set it on the machines that can serve
# "host of the day"; rotation prefers nodes that have this set.
# `npm run tunnel` starts a Cloudflare quick tunnel against PORT and writes the
# URL here for you. For a stable address, use a named tunnel
# (`cloudflared tunnel create ops` + `cloudflared tunnel run ops`) and put its
# hostname here instead; quick-tunnel hostnames change on every restart.
#PUBLIC_URL=https://desk2.example.ts.net

# Shared secret for machine-to-machine fleet calls (join, heartbeat, run, remove).
FLEET_TOKEN=change-me

# Server. Keep this equal to the port your tunnel points at: the bundled
# `npm run tunnel` script reads this value, and a mismatch is the usual reason a
# tunnel answers 502.
PORT=3000
#OLLAMA_URL=http://localhost:11434
#KILO_URL=http://127.0.0.1:7777
#ALLOWED_FS_ROOTS=C:\Users\you\computera-ops
# Model used when a fleet task is executed on Ollama (defaults to the first installed model).
#FLEET_OLLAMA_MODEL=qwen2.5-coder:1.5b

# ---------------------------------------------------------------
# Sprint harness (DeepSeek Harness, `dsh`)
# Sprints run through dsh's headless profile; chat and ad-hoc tasks keep using
# the engines above. `auto` uses dsh when it is installed and falls back to
# fleet dispatch when it is not. `dsh` makes a missing harness a visible failure.
#SPRINT_RUNNER=auto

# DeepSeek route (only needed when the harness talks to DeepSeek).
#DEEPSEEK_API_KEY=
#
# Local route: point the harness at Ollama instead of a cloud model. The profile
# patch in data/dsh-home/profiles/headless/cordis.patch.yml declares the provider
# and default model; apiKeyEnv only has to resolve (Ollama ignores the value).
# The harness home is exported by the runner (data/dsh-home) and must NOT be put
# in this file: dsh treats DSH_HOME as launch-only and refuses to start otherwise.
#OLLAMA_API_KEY=ollama
# Path to the dsh launcher when it is not on PATH (e.g. node_modules/.bin/dsh.cmd).
#DSH_BIN=
# Optional: allow `npx --yes @deepseek-ai/dsh` when no local install exists.
#DSH_NPX=1
#DSH_HOME=C:\\Users\\you\\.dsh
# Working directory for harness runs (defaults to this folder).
#DSH_WORKDIR=C:\\Users\\you\\computera-ops
# Per-step ceiling; the sprint's own durationHours is the overall budget (max 10h by default).
#DSH_STEP_TIMEOUT_MS=36000000
# One harness process at a time keeps long sprints from starving the preview.
#DSH_MAX_CONCURRENCY=1
# Optional: point the web profile at loopback (it is pinned to 127.0.0.1 anyway).
#DSH_PROFILE=headless
#DSH_HOST=127.0.0.1
# Abort a run after this many failed /api/health checks on this node.
#PREVIEW_GUARD_FAILURES=3

# Web search for the chat agent (Exa). Declared empty on purpose: the app boots
# without it, and POST /api/web/search plus the agent's web_search tool answer
# 503 until a key is set on the node. Create one at
# https://dashboard.exa.ai/api-keys.
EXA_API_KEY=

# Public link hardening: enable when today's link is reachable from the internet.
# Tool execution then requires the fleet token or Basic auth, and the UI itself needs
# today's link token.
#PUBLIC_MODE=1

# Workspace sharing for people holding today's link: off | read | write (default read).
# Shared access is scoped to SHARED_FS_ROOT and skips dotfiles, data/, memory/, node_modules/.
#WORKSPACE_SHARE=write
#SHARED_FS_ROOT=C:\Users\you\computera-ops
#BASIC_AUTH_USER=ops
#BASIC_AUTH_PASS=change-me

# Studio document pane: proxy (default) serves POV from this origin so saves come back;
# embed frames the public site instead (no bridge, no save-back).
POV_MODE=proxy

# Direct Ollama sprint runner (plain chat, no tool schemas) for small local models.
#SPRINT_RUNNER=ollama
#SPRINT_OLLAMA_MODEL=qwen2.5-coder:1.5b
#SPRINT_OLLAMA_TIMEOUT_MS=1200000
